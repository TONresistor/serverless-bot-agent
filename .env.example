OWNER_ID=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_API_KEY=
TON_NETWORK=mainnet
TONCENTER_API_KEY=
# Serverless CLI access token. Used by deploy and administrative scripts.
# Alternatively, deploy can use npx tgcloud login; admin scripts prompt when unset.
TGCLOUD_TOKEN=
# Optional web provider: independent Tavily, or a MyDuckAI-compatible HTTPS proxy.
# Configure with: node scripts/web.mjs configure
TAVILY_API_KEY=
WEB_TOOLS_URL=
WEB_TOOLS_KEY=

# Optional automatic Uranus logo/metadata hosting. Existing metadata_uri needs no key.
PINATA_JWT=
